---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { moments } from "@/utils/moments";
---

<BaseLayout title="动态">
  <section class="simple-page">
    <p class="eyebrow">Moments</p>
    <h1>动态</h1>
    <div class="moment-list page-list">
      {
        moments.map((moment) => {
          const Content = moment.Content;
          return (
            <article class="moment-item moment-entry">
              <div class="moment-content">
                {moment.hasTitle && <h2>{moment.title}</h2>}
                <Content />
              </div>
              <time datetime={moment.date}>{moment.date}</time>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
