---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { posts } from "@/utils/posts";
import { taxonomySlug, tagUrl } from "@/utils/taxonomy";

export function getStaticPaths() {
  const categories = posts.reduce((categoryMap, post) => {
    const slug = taxonomySlug(post.category);

    if (!categoryMap.has(slug)) {
      categoryMap.set(slug, post.category);
    }

    return categoryMap;
  }, new Map<string, string>());

  return [...categories].map(([slug, category]) => ({
    params: { category: slug },
    props: {
      category,
      categoryPosts: posts.filter((post) => taxonomySlug(post.category) === slug),
    },
  }));
}

const { category, categoryPosts } = Astro.props;
---

<BaseLayout title={`分类：${category}`}>
  <section class="simple-page">
    <p class="eyebrow">Category</p>
    <h1>{category}</h1>
    <div class="article-list page-list">
      {
        categoryPosts.map((post) => (
          <article class="moment-item article-row">
            <div class="article-title-line">
              <h3><a href={post.href}>{post.title}</a></h3>
            </div>
            <div class="article-side-meta">
              <div class="article-taxonomy">
                {post.tags.map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}
              </div>
              <time datetime={post.date}>{post.date}</time>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
