const footerSocialLinks = site.socialLinks.map((item) => ({
  ...item,
  iconShape:
    fontAwesomeIcons[
      (
        {
          github: "github",
          mastodon: "mastodon",
          mail: "mail",
          qq: "qq",
          wechat: "wechat",
          rss: "rss",
        } as const
      )[item.icon as "github" | "mastodon" | "mail" | "qq" | "wechat" | "rss"]
    ],
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={site.favicon} />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script is:inline>
      (() => {
        const themes = ["paper", "pine", "dark"];
        const storedTheme = localStorage.getItem("theme-mode");
        const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "paper";
        document.documentElement.dataset.theme = themes.includes(storedTheme) ? storedTheme : preferredTheme;
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label={`${site.title} 首页`}>
          <img class="brand-mark" src={site.logo} alt="" />
          <span class="brand-text">
            <span class="brand-title">{site.title}</span>
            <span class="brand-subtitle">个人写作与动态</span>
          </span>
        </a>

        <nav class="nav" aria-label="主导航">
          {
            fontAwesomeNavItems.map((item) => (
              <a class:list={["nav-link", currentPath === item.href && "is-active"]} href={item.href} aria-label={item.label} title={item.label}>
                <i class:list={["nav-fa-icon", item.iconClass]} aria-hidden="true"></i>
              </a>
            ))
          }
          <button class="nav-link nav-button" type="button" aria-label="搜索" title="搜索" data-search-toggle>
            <i class:list={["nav-fa-icon", fontAwesomeV6Controls.search]} aria-hidden="true"></i>
          </button>
          <div class="nav-travel" data-travel-menu>
            <button class="nav-link nav-button travel-toggle" type="button" aria-label="空间穿梭" title="空间穿梭" aria-expanded="false" data-travel-toggle>
              <i class:list={["nav-fa-icon", fontAwesomeV6Controls.rocket]} aria-hidden="true"></i>
            </button>
            <div class="travel-menu" aria-label="空间穿梭链接">
              {
                travelLinks.map((item) => (
                  <a href={item.href} target="_blank" rel="noreferrer">
                    <span>{item.name}</span>
                    <small>{item.host}</small>
                  </a>
                ))
              }
            </div>
          </div>
          <button class="nav-link nav-button" type="button" aria-label="切换主题颜色" title="切换主题颜色" data-theme-toggle>
            <i class:list={["nav-fa-icon", fontAwesomeV6Controls.theme]} aria-hidden="true"></i>
          </button>
        </nav>
        <div class="search-panel" data-search-panel hidden>
          <label class="search-label" for="site-search">搜索</label>
          <input id="site-search" class="search-input" type="search" placeholder="输入文章标题或标签" autocomplete="off" data-search-input />
          <div class="search-results" data-search-results>
            {
              posts.map((post) => (
                <a class="search-result" href={post.href} data-search-item={`${post.title} ${post.category} ${post.tags.join(" ")}`}>
                  <span>{post.title}</span>
                  <small>{post.category} · {post.tags.map((tag) => `#${tag}`).join(" ")}</small>
                </a>
              ))
            }
          </div>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class:list={["site-footer", isHome && "is-home-footer"]}>
        <div class="footer-copy" aria-label="版权和社交网络">
          <span>© {site.copyrightYears} {site.owner}</span>
          <span class="footer-separator">|</span>
          <div class="social-links" aria-label="社交网络">
            {
              footerSocialLinks.map((item) => (
                <a class="social-icon" href={item.href} aria-label={item.name} title={item.name}>
                  <svg aria-hidden="true" viewBox={item.iconShape.viewBox}>
                    {item.iconShape.paths.map((path) => <path d={path} />)}
                  </svg>
                </a>
              ))
            }
          </div>
        </div>
        <div class="footer-meta">
          <span>Powered by</span>
          <svg class="footer-tech-icon" aria-hidden="true" viewBox={simpleIcons.astro.viewBox}>
            {simpleIcons.astro.paths.map((path) => <path d={path} />)}
          </svg>
          <span class="footer-separator">·</span>
          <a class="footer-repo-link" href={site.themeRepository} aria-label="主题仓库" title="主题仓库">
            <svg aria-hidden="true" viewBox={fontAwesomeIcons.github.viewBox}>
              {fontAwesomeIcons.github.paths.map((path) => <path d={path} />)}
            </svg>
          </a>
        </div>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeButton = document.querySelector("[data-theme-toggle]");
        const searchButton = document.querySelector("[data-search-toggle]");
        const searchPanel = document.querySelector("[data-search-panel]");
        const searchInput = document.querySelector("[data-search-input]");
        const searchItems = [...document.querySelectorAll("[data-search-item]")];
        const travelMenu = document.querySelector("[data-travel-menu]");
        const travelButton = document.querySelector("[data-travel-toggle]");
        let travelCloseTimer;

        const themes = ["paper", "pine", "dark"];
        const themeNames = {
          paper: "旧纸",
          pine: "苔墨",
          dark: "夜间",
        };

        const getNextTheme = (theme) => {
          const index = themes.indexOf(theme);
          return themes[(index + 1) % themes.length];
        };

        const setTheme = (theme) => {
          const nextTheme = getNextTheme(theme);
          root.dataset.theme = theme;
          localStorage.setItem("theme-mode", theme);
          themeButton?.setAttribute("aria-label", `切换主题颜色，当前${themeNames[theme]}，下一项${themeNames[nextTheme]}`);
          themeButton?.setAttribute("title", `主题：${themeNames[theme]}，点击切换到${themeNames[nextTheme]}`);
        };

        setTheme(themes.includes(root.dataset.theme) ? root.dataset.theme : "paper");
        themeButton?.addEventListener("click", () => {
          setTheme(getNextTheme(root.dataset.theme || "paper"));
        });

        searchButton?.addEventListener("click", () => {
          const isOpening = searchPanel?.hasAttribute("hidden");
          searchPanel?.toggleAttribute("hidden", !isOpening);
          searchButton.setAttribute("aria-expanded", String(Boolean(isOpening)));
          if (isOpening) window.setTimeout(() => searchInput?.focus(), 0);
        });

        travelButton?.addEventListener("click", () => {
          const isOpen = travelMenu?.classList.toggle("is-open");
          travelButton.setAttribute("aria-expanded", String(Boolean(isOpen)));
        });

        travelMenu?.addEventListener("mouseenter", () => {
          window.clearTimeout(travelCloseTimer);
          travelMenu.classList.add("is-hover-open");
          travelButton?.setAttribute("aria-expanded", "true");
        });

        travelMenu?.addEventListener("mouseleave", () => {
          travelCloseTimer = window.setTimeout(() => {
            travelMenu.classList.remove("is-hover-open");
            if (!travelMenu.classList.contains("is-open")) {
              travelButton?.setAttribute("aria-expanded", "false");
            }
          }, 650);
        });

        document.addEventListener("click", (event) => {
          if (!travelMenu?.contains(event.target)) {
            travelMenu?.classList.remove("is-open");
            travelMenu?.classList.remove("is-hover-open");
            travelButton?.setAttribute("aria-expanded", "false");
          }
        });

        searchInput?.addEventListener("input", () => {
          const keyword = searchInput.value.trim().toLowerCase();
          searchItems.forEach((item) => {
            const text = item.getAttribute("data-search-item")?.toLowerCase() || "";
            item.toggleAttribute("hidden", Boolean(keyword) && !text.includes(keyword));
          });
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            searchPanel?.setAttribute("hidden", "");
            searchButton?.setAttribute("aria-expanded", "false");
            travelMenu?.classList.remove("is-open");
            travelMenu?.classList.remove("is-hover-open");
            travelButton?.setAttribute("aria-expanded", "false");
          }
        });
      })();
    </script>
  </body>
</html>
